      ],
      "vendor_data": [
        {"vendor": "Contradictory Vendor", "parameter": "Rated voltage", "value": "415 V", "evidence": "quote p.1", "claim_status": "VERIFIED", "provenance": {"source": "contradictory-quote.pdf", "page": 1, "section": "Cover"}},
