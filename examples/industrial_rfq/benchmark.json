{
  "benchmark_version": "1.0",
  "purpose": "Representative evidence-aware benchmark for industrial RFQ extraction and deterministic comparison.",
  "cases": [
    {
      "id": "TXT-01",
      "source_format": "txt",
      "scenario": "plain_text",
      "description": "Plain-text motor RFQ with one compliant and one deviating vendor.",
      "requirements": [
        {"tag": "R-01", "parameter": "Rated voltage", "required": "415 V"},
        {"tag": "R-02", "parameter": "Motor power", "required": "75 kW"},
        {"tag": "R-03", "parameter": "Efficiency class", "required": "IE3"}
      ],
      "vendor_data": [
        {"vendor": "Vendor A", "parameter": "Rated voltage", "value": "0.415 kV", "evidence": "Vendor A quote p.1", "claim_status": "VERIFIED", "provenance": {"source": "vendor-a.txt", "page": 1, "section": "Technical data"}},
        {"vendor": "Vendor A", "parameter": "Motor power", "value": "75 kW", "evidence": "Vendor A quote p.1", "claim_status": "VERIFIED", "provenance": {"source": "vendor-a.txt", "page": 1, "section": "Technical data"}},
        {"vendor": "Vendor A", "parameter": "Efficiency class", "value": "IE3", "evidence": "Vendor A quote p.2", "claim_status": "VERIFIED", "provenance": {"source": "vendor-a.txt", "page": 2, "section": "Motor data"}},
        {"vendor": "Vendor B", "parameter": "Rated voltage", "value": "415 V", "evidence": "Vendor B quote p.1", "claim_status": "VERIFIED", "provenance": {"source": "vendor-b.txt", "page": 1, "section": "Technical data"}},
        {"vendor": "Vendor B", "parameter": "Motor power", "value": "75 kW", "evidence": "Vendor B quote p.1", "claim_status": "VERIFIED", "provenance": {"source": "vendor-b.txt", "page": 1, "section": "Technical data"}},
        {"vendor": "Vendor B", "parameter": "Efficiency class", "value": "IE2", "evidence": "Vendor B quote p.2", "claim_status": "VERIFIED", "provenance": {"source": "vendor-b.txt", "page": 2, "section": "Motor data"}}
      ],
      "expected_statuses": ["COMPLIANT", "COMPLIANT", "COMPLIANT", "COMPLIANT", "COMPLIANT", "DEVIATION"]
    },
    {
