        {"vendor": "Vendor PDF", "parameter": "Frequency", "value": "50 Hz", "evidence": "vendor-pdf.pdf p.3", "claim_status": "VERIFIED", "provenance": {"source": "vendor-pdf.pdf", "page": 3, "section": "Nameplate"}},
        {"vendor": "Vendor PDF", "parameter": "Rated current", "value": "98 A", "evidence": "vendor-pdf.pdf p.3", "claim_status": "VERIFIED", "provenance": {"source": "vendor-pdf.pdf", "page": 3, "section": "Nameplate"}}
      ],
      "expected_statuses": ["COMPLIANT", "COMPLIANT", "DEVIATION"]
